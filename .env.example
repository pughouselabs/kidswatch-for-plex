# Public settings only. Keep credentials in their existing read-only files.
# Replace the example hostname and Plex service address before starting.
# Apply edits with: docker compose up -d --force-recreate kidswatch (not restart).
PK_PUBLIC_URL=https://kids.example.com
PK_PLEX_PREFS=/plex-prefs/Preferences.xml
PK_PLEX_URL=http://plex-host:32400
PK_DB=/data/plexkids.db
PK_TZ=UTC
# Positive whole seconds, at least 1. Invalid values stop startup.
PK_POLL_SECONDS=20
PK_SEED_PARENTS=
PK_KID_SECTIONS=1,2
PK_SECURE_COOKIES=1
PK_OWNER_NAME=Admin
# Optional plain-text branding (80 / 240 characters); empty keeps existing text.
PK_APP_NAME=
PK_FOOTER_TEXT=
# Optional read-only poster directory with art.json; see docs/owner-branding.md.
PK_LANDING_ART_DIR=
PK_START_ENFORCER=1
# The second sign-in step stays required, even without a notification receiver.
PK_OWNER_CODE=1
# Optional. Set a container file path after configuring code delivery.
PK_HA_WEBHOOK_FILE=
# Optional watch history. Set both and uncomment the read-only Compose mount.
PK_TAUTULLI_URL=
PK_TAUTULLI_CONFIG=
# Optional link to your request site. Empty uses the built-in Requests form.
PK_MEDIA_REQUEST_URL=
# Your reverse proxy's address as the app sees it (IPs or ranges, comma-separated).
# Empty ignores forwarded headers. The app log names the address to use once a proxy connects.
PK_TRUSTED_PROXIES=
# 1 only if a trusted proxy above passes Cloudflare's CF-Connecting-IP and CF-IPCountry.
PK_TRUST_CF_HEADERS=0
